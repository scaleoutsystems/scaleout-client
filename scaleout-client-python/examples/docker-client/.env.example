# Copy to .env and fill in before running `docker compose up`.

# URL of your Scaleout Edge instance, e.g. https://mytenant.scaleoutsystems.com
SCALEOUT_API_URL=

# Stable identifier for this client (e.g. a device serial number). Keeping
# this stable lets the client resume from its cached credentials on restart
# instead of re-enrolling.
SCALEOUT_CLIENT_ID=

# Enrollment token, created with:
#   scaleout client create-enrollment-token --name docker-example
# Only needed for the FIRST run: once the client enrolls successfully, its
# refresh token is cached in the scaleout_tokens volume, and this can be
# removed (or left blank) on subsequent runs.
SCALEOUT_TOKEN=

# Optional human-readable label for this client.
SCALEOUT_CLIENT_NAME=
